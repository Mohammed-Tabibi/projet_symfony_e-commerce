{% extends 'base.html.twig' %}

{% block title %}Our Categories - Our Store{% endblock %}

{% block body %}
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">Our Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_categories') }}">Categories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_cart') }}">Cart</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-5 text-center">
        <h1 class="mb-5">Our Categories</h1>
        <div class="row g-4">
            {% for category in categories %}
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm category-card">
                        <div class="card-body py-5">
                            <h3 class="card-title">{{ category.name }}</h3>
                            <p class="text-muted">{{ category.products|length }} Products available</p>
                            <a href="{{ path('app_products_by_category', {'id': category.id}) }}" class="btn btn-outline-primary mt-3">Explore</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <p>No categories found.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .category-card { transition: transform 0.3s; cursor: pointer; }
        .category-card:hover { transform: translateY(-10px); }
    </style>
{% endblock %}
