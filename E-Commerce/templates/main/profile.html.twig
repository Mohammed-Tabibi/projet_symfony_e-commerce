{% extends 'base.html.twig' %}

{% block title %}My Profile - Our Store{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <img src="{{ asset('assets/images/profile.png') }}" class="rounded-circle mb-3" alt="Profile" style="width: 150px; height: 150px; object-fit: cover;">
                        <h5 class="mb-1">{{ app.user.mohammed }}</h5>
                        <p class="text-muted small mb-3">Member since {{ "now"|date("M Y") }}</p>
                        <div class="list-group list-group-flush text-start">
                            <a href="#info" class="list-group-item list-group-item-action active">Personal Info</a>
                            <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-danger">Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="col-md-9">
                <div class="card shadow-sm mb-4" id="info">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold">Full Name:</label>
                                <p>{{ app.user.mohammed }}</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold">Email:</label>
                                <p>{{ app.user.email }}</p>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold">Phone:</label>
                                <p>+1 (555) 123-4567</p>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary">Edit Profile</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}
