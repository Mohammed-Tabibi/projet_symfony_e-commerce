{% extends 'base.html.twig' %}

{% block title %}My Profile - Our Store{% endblock %}

{% block body %}
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">Our Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_cart') }}">Cart</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_profile') }}">Profile</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <img src="{{ asset('assets/images/profile.png') }}" class="rounded-circle mb-3" alt="Profile" style="width: 150px; height: 150px; object-fit: cover;">
                        <h5 class="mb-1">John Doe</h5>
                        <p class="text-muted small mb-3">Member since Jan 2024</p>
                        <div class="list-group list-group-flush text-start">
                            <a href="#info" class="list-group-item list-group-item-action active">Personal Info</a>
                            <a href="#orders" class="list-group-item list-group-item-action">Orders</a>
                            <a href="#settings" class="list-group-item list-group-item-action">Account Settings</a>
                            <a href="#" class="list-group-item list-group-item-action text-danger">Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="col-md-9">
                <div class="card shadow-sm mb-4" id="info">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold">Full Name:</label>
                                <p>John Doe</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold">Email:</label>
                                <p>john.doe@example.com</p>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold">Phone:</label>
                                <p>+1 (555) 123-4567</p>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary">Edit Profile</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}
